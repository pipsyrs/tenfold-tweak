#!/usr/bin/env python3
"""Entry point: CLI with arguments, GTK GUI with none (when a display is present)."""

import os
import sys

sys.dont_write_bytecode = True  # no root-owned .pyc next to an installed copy
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from tenfold_tweak import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
